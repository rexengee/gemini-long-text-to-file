{
  "manifest_version": 3,
  "name": "Gemini Long Text to File",
  "version": "1.0.1",
  "description": "Gemini sohbetlerinde uzun metin yapıştırıldığında donmayı önler ve metni otomatik olarak .txt dosyası ekine dönüştürür.",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "gemini-long-text-to-file@ozcanege.dev",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["page_bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content.js"],
      "world": "ISOLATED",
      "run_at": "document_start"
    }
  ]
}